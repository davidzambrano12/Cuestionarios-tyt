# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Entorno: dev (por defecto) o prod
DJANGO_ENV=dev
DJANGO_DEBUG=True
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Muestra en el login los botones de acceso rápido de demostración (por defecto igual a DEBUG)
MOSTRAR_ACCESOS_DEMO=True

# MariaDB
DB_NAME=simulador_tyt
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Conexión cifrada a la base en la nube (True en producción).
# DB_SSL_CA: ruta al certificado CA del proveedor, relativa al proyecto (opcional).
DB_SSL=False
DB_SSL_CA=

# Solo producción
# Orígenes HTTPS confiables para formularios; si se omite se deriva de DJANGO_ALLOWED_HOSTS
DJANGO_CSRF_TRUSTED_ORIGINS=
# En Vercel solo /tmp admite escritura
DJANGO_MEDIA_ROOT=
